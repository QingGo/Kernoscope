.venv/
__pycache__/
*.pyc
.pytest_cache/
*.ksreport.json
*.perfetto.json
*_nsys.nsys-rep
*_nsys.sqlite


docs/

# 同步到不带 .git 的远端时，用这个文件承载修订号（它是每次部署产生的，不入库）
/REVISION

# NVBit 工具的构建产物（源码在仓库里，产物不入库）
tools/probes/nvbit_memtrace/*.so
tools/probes/nvbit_memtrace/*.o
tools/probes/nvbit_memtrace/memtest
tools/probes/nvbit_memtrace/ks-memtrace*.txt
tools/probes/nvbit_memtrace/build/

# skill 脚本的产物（本机自检文件与一次取证的报告）
# 只忽略**仓库根**下的这一份：产物目录里的 machine-selfcheck.json 是登记表引用的证据
# （「现行产物」小节的 MDD 就来自它），必须入库 —— 否则本地有 CI 没有，文档里的数字
# 在 CI 里无法核对（真事：test_doc_artifact_consistency 只在 CI 红）。
/machine-selfcheck.json
ks-evidence/

# bench：编译产物与原始轨迹（体积大、按需重采；分析产物会入库）
bench/artifacts/.build/
bench/artifacts/*/memtrace-official.txt

# W8 评测台：默认输出目录（每次运行都重新生成，不入库）
eval/runs/

# 打包产物（uv build / python -m build 生成，不入库）
dist/
/build/
*.egg-info/

# demo 产物（截图/HTML/决策包都在这里，不入库）
demo/out/
