    {
      "id": "dram_bytes",
      "question": "DRAM 搬了多少字节 / 是不是 DRAM bound（NVML 代理口径）",
      "state": "degraded",
      "tier_required": 1,
      "outputs": [
        "est__dram_bytes_total",
        "ks__sampler_window_coverage_pct"
      ],
      "how": "没有本机标定：代理口径缺少实测峰值，roofline/DRAM 字节会拒绝给数而不是用规格表顶替",
      "alternative": "轨迹口径 dram_bytes_trace（只测被追踪的 kernel）"
    },
    {
      "id": "roofline",
      "question": "离 roofline 多远、compute 还是 memory bound",
      "state": "degraded",
      "tier_required": 1,
      "outputs": [
        "est__achieved_gbs",
        "est__bound",
        "est__roofline_efficiency_pct"
      ],
      "how": "没有给工作量（FLOPs/bytes）：只能给带宽与时长侧",
      "alternative": "给 --ks-gemm 或 --ks-flops/--ks-bytes 才能算"
    },
    {
      "id": "achieved_occupancy",
      "question": "实际达到的 occupancy（不是上界）",
      "state": "refused",
      "tier_required": 3,
      "outputs": [
        "meas__achieved_occupancy_pct"
      ],
      "how": "没跑 occupancy 探针",
      "alternative": "用探针区间重叠重建；没有探针时只给理论上界",
      "refusal": {
        "code": "no_occupancy_probe",
        "message": "没跑 occupancy 探针：实际达到的 occupancy 需要 (smid, globaltimer) 探针",
        "severity": "blocking",
        "observed": {},
        "threshold": {},
        "remedy": {
          "action": "跑 occupancy 探针并把 JSON 用 --ks-achieved-occupancy 传进来（需要 NVBit）",
          "command": "kernoscope occupancy --records <probe-records> -o occ.json",
          "cost_s": 600.0,
          "cost_kind": "wall_seconds",
          "then_answers": [
            "achieved_occupancy"
          ]
        }
      }
    },
    {
      "id": "dram_bytes_trace",
      "question": "DRAM 字节的第二条口径（访存轨迹 + 缓存模型）",
      "state": "refused",
      "tier_required": 3,
      "outputs": [
        "est__dram_bytes_per_launch_trace",
        "meas__sectors_per_request"
