        "code": "no_memtrace",
        "message": "没有提供轨迹文件：加 --ks-memtrace <trace> 换轨迹口径",
        "severity": "blocking",
        "observed": {},
        "threshold": {},
        "remedy": {
          "action": "加 --ks-memtrace <trace>：轨迹口径只测被追踪的 kernel，不受窗口构成影响",
          "command": "kernoscope --ks-memtrace ks-memtrace.txt ...",
          "cost_s": 600.0,
          "cost_kind": "wall_seconds",
          "then_answers": [
            "dram_bytes_trace",
            "l2_hit_rate"
          ]
        }
      }
    },
    {
