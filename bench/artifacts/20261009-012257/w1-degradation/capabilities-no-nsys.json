{
  "schema_version": 1,
  "tool": "kernoscope",
  "tool_version": "0.2.0",
  "tier": {
    "level": 3,
    "name": "instrumented",
    "gives": "指令级：访存轨迹（sectors/request、L2 命中模型）、动态指令数、发射槽利用率上界"
  },
  "next_tier": {
    "level": 4,
    "name": "counters",
    "needs": "ncu 可用权限（CAP_SYS_ADMIN / RmProfilingAdminOnly=0）",
    "gives": "与 ncu 同源的硬件计数器：精确 DRAM 字节、各 pipe 利用率、stall 周期细分"
  },
  "env": {
    "has_gpu": true,
    "gpu_name": "NVIDIA GeForce RTX 4090",
    "has_nvml": true,
    "has_nsys": false,
    "has_cuobjdump": true,
    "has_ncu": true,
    "counter_state": "denied",
    "has_nvbit": true,
    "has_calibration": false,
    "has_workload": false,
    "has_memtrace": false,
    "has_instr_hist": false,
    "has_occupancy_probe": false,
    "has_cubin": false,
    "nvml_disabled_by_user": false
  },
  "matrix": {
    "kernel_time": "refused",
    "launch_configs": "refused",
    "static_resources": "refused",
    "theoretical_occupancy": "refused",
    "device_busy": "available",
    "dram_bytes": "degraded",
    "roofline": "degraded",
    "achieved_occupancy": "refused",
    "dram_bytes_trace": "refused",
