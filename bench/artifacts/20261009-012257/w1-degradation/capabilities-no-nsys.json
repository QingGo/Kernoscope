    {
      "id": "kernel_time",
      "question": "哪个 kernel 最耗时、每次跑多久",
      "state": "refused",
      "tier_required": 2,
      "outputs": [
        "gpu__time_duration.sum",
        "ks__launch_time_mean"
      ],
      "how": "缺少 nsys（CUPTI activity 的唯一来源）",
      "refusal": {
        "code": "nsys_missing",
        "message": "缺少 nsys：kernel 级精确量（时长/launch 配置）拿不到；设备级读数仍然可用",
        "severity": "blocking",
        "observed": {},
        "threshold": {},
        "remedy": {
          "action": "安装 Nsight Systems（随 CUDA Toolkit 提供），或提供已有的 .nsys-rep/.sqlite",
          "command": "kernoscope --ks-sqlite <kernels.sqlite>",
          "cost_s": 0.0,
          "cost_kind": "manual",
          "then_answers": [
            "kernel_times",
            "launch_configs"
          ]
        }
      }
    },
